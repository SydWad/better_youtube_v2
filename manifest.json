{
  "manifest_version": 2,
  "name": "Better YouTube v2",
  "version": "1.0.0",
  "description": "Customize the YouTube interface and store a permanent, searchable watch history.",
  "browser_specific_settings": {
    "gecko": {
      "id": "better-youtube-v2@sydwad",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": []
      }
    }
  },
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "downloads",
    "tabs",
    "webRequest",
    "webRequestBlocking",
    "https://www.youtube.com/*",
    "*://i.ytimg.com/*"
  ],
  "web_accessible_resources": [
    "icons/icon128.png",
    "icons/icon48.png",
    "icons/icon16.png"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": [
        "content/shared.js",
        "content/actor.js",
        "content/flag_shorts.js",
        "content/flag_membersonly.js",
        "content/flag_watched.js",
        "content/advanced/flag_autodubed.js",
        "content/advanced/flag_blacklist.js",
        "content/advanced/flag_livestreams.js",
        "content/advanced/flag_playlists.js",
        "content/advanced/flag_viewcount.js",
        "content/advanced/flag_length.js",
        "content/advanced/flag_upcoming-scheduled.js",
        "content/master.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.youtube.com/feed/history*"],
      "js": ["history_scroller.js", "history_overlay.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_action": {
    "default_popup": "UI/popup.html",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "UI/options.html"
}
